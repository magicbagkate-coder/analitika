# Server
PORT=3000
NODE_ENV=development

# Sitniks CRM (base host only — paths already include /open-api/... in code)
SITNIKS_API_URL=https://crm.sitniks.com
SITNIKS_API_KEY=replace-me

# Claude (Anthropic)
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-5

# Telegram
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# Postgres (провизия на сервере, приложение пока не подключено к БД)
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=magicbag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Touch bot (video touch + 08:00 closing). Without TOUCH_MODE nothing runs. dry-run = only describes to the owner, live = really sends.
# TOUCH_MODE=off
# TOUCH_TARGET_STATUS=Вибір товару
# TOUCH_CLOSED_STATUS=Завершено
# TOUCH_WAIT_MINUTES=60
# TOUCH_VIDEO_FOLDER_ID=replace-me
# TELEGRAM_OWNER_CHAT_ID=replace-me
