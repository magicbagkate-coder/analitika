# Server
PORT=3000
NODE_ENV=development

# Sitniks CRM (base host only — paths already include /open-api/... in code)
SITNIKS_API_URL=https://crm.sitniks.com
SITNIKS_API_KEY=replace-me

# Claude (Anthropic)
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-5

# Telegram
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# Postgres (провизия на сервере, приложение пока не подключено к БД)
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=magicbag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
